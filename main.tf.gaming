terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

# Configure the AWS Provider
provider "aws" {
  region = "us-west-1"
}

#create a s3 bucket
resource "aws_s3_bucket" "chandu_bucket" {
  bucket = "chandu4567890"
  tags = {
    Name        = "chandu_bucket"
    Environment = "Dev"
  }
}
# create a VPC
data "aws_vpc" "default" {
  default = true
}

# create an subnet for public access
data "aws_subnets" "game" {
  filter {
    name = "vpc-id"
    values = [ data.aws_vpc.default.id]
  }
  
}

# create a iam role for eks cluster 
resource "aws_iam_role" "eks_cluster_role" {
  name = "eks_cluster_role"
  assume_role_policy = jsonencode(
    {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "eks.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
  )
}
# attach iam role policy for the eks cluster
resource "aws_iam_role_policy_attachment" "policy_attach_eks_cluster" {
  role = aws_iam_role.eks_cluster_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"
}
#create a IAM role for the node group
resource "aws_iam_role" "iam_role_for_node_group" {
  name = "iam_role_for_node_group"
  assume_role_policy = jsonencode(
     {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "ec2.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
  )
}
# attach iam role attachment for the node group
resource "aws_iam_role_policy_attachment" "woker_policy_attachment_for_nodegroup" {
  role = aws_iam_role.iam_role_for_node_group.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy"
}
# attach iam role attachment for the cni policy
resource "aws_iam_role_policy_attachment" "cni_policy_attachment_to_nodePort" {
role = aws_iam_role.iam_role_for_node_group.name
policy_arn = "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"
}
#attach iam role for the amazon ec2 container registry read only
resource "aws_iam_role_policy_attachment" "ec2_container_registry_read_only_for_nodegroup" {
  role =aws_iam_role.iam_role_for_node_group.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly"
}
# create the eks cluster
resource "aws_eks_cluster" "gaming_cluster_poject" {
  name = "gaming_cluster_project"
  role_arn = aws_iam_role.eks_cluster_role.arn
  vpc_config {
    subnet_ids =  data.aws_subnets.game.ids
  }
  depends_on = [ aws_iam_role_policy_attachment.policy_attach_eks_cluster ]
}
#create a node group for the eks cluster
resource "aws_eks_node_group" "gaming_project_nodegroup" {
  cluster_name = aws_eks_cluster.gaming_cluster_poject.name
  node_group_name = "gaming_project_nodegroup"
  node_role_arn = aws_iam_role.iam_role_for_node_group.arn
  subnet_ids =  data.aws_subnets.game.ids
  scaling_config {
    desired_size = 2
    max_size     = 2
    min_size     = 2
  }
  depends_on = [ aws_iam_role_policy_attachment.woker_policy_attachment_for_nodegroup, aws_iam_role_policy_attachment.cni_policy_attachment_to_nodePort,aws_iam_role_policy_attachment.ec2_container_registry_read_only_for_nodegroup ]
  instance_types = ["t2.large"]  
}




